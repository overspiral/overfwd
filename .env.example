# Connection contract for the REST -> IMAP/SMTP bridge and its e2e tests.
# Copy to `.env` in each worktree (`.env` is gitignored). All worktrees point at
# the SAME shared GreenMail stack on localhost — do NOT start a second stack.

# --- overfwd gateway (the server itself) ---
# Listen address. MUST NOT be :8080 — that is GreenMail's management API above.
OVERFWD_BIND=0.0.0.0:8000
# Axis-1 gateway access (SPEC §5). When true, requests must carry
# `Authorization: Bearer $OVERFWD_API_KEY`. Off is a valid self-host posture.
OVERFWD_REQUIRE_API_KEY=false
# The single static gateway api_key. Required only when the toggle above is true.
# OVERFWD_API_KEY=change-me

# --- IMAP connection pool (SPEC §4) ---
# Ephemeral, in-memory only: warm connections are lost on restart, never persisted,
# best-effort under serverless lifecycles (per-request login is the fallback).
# Max idle connections held across all credentials (global, LRU-evicted). 0 disables
# pooling entirely. Default: 32.
# OVERFWD_POOL_MAX_IDLE=32
# How long (seconds) an idle connection may be reused before it is discarded. Keep it
# short. Default: 60.
# OVERFWD_POOL_IDLE_TTL_SECS=60

# --- SMTP (outbound) ---
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=3025
MAIL_SMTP_TLS_PORT=3465

# --- IMAP (inbound) ---
MAIL_IMAP_HOST=localhost
MAIL_IMAP_PORT=3143
MAIL_IMAP_TLS_PORT=3993

# --- Credentials (preconfigured GreenMail users) ---
# IMPORTANT: SMTP AUTH / IMAP LOGIN use the *login id* (short form), not the email.
MAIL_USER=test              # login id (email is test@localhost)
MAIL_PASS=test
MAIL_ADDRESS=test@localhost # the actual email address for envelope From/To
# second seeded account: login `alice` / pass `alice` / address alice@localhost

# GreenMail TLS ports use a built-in self-signed cert: clients must skip verification.
MAIL_TLS_INSECURE=true

# Management REST API (reset state, inspect mail, add users at runtime).
GREENMAIL_API=http://localhost:8080
